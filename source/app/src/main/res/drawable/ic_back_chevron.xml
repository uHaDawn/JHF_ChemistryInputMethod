     放进任意 ImageView 都由 fitCenter 保持原始宽高比。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="10dp"
    android:height="18dp"
    android:viewportWidth="10"
    android:viewportHeight="18">
