# 统一换行，避免 LF/CRLF 反复警告
*.java   text eol=crlf
*.xml    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.py     text eol=lf

# 二进制资源不做换行转换
*.so     binary
*.png    binary
*.jpg    binary
*.apk    binary
*.jks    binary
*.xz     binary
